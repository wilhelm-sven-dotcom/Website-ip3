  }

  :global(.js-motion) .es__ohne-js,
  .es[data-js] .es__ohne-js {
    display: none;
  }

  /* Textliste aller Elemente (ohne JavaScript geöffnet) */
  .es__liste {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--on-navy-line);
  }

  .es__liste-kopf {
