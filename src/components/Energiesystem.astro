  /* Zeitmarke: Ebene in voller Skalenbreite, verschoben per transform (Prozent der eigenen
     Breite = Prozent der Skala); kein Layout pro Bild */
  .es__marke {
    position: absolute;
    top: -4px;
    bottom: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    will-change: transform;
  }

  .es__marke::before,
  .es__marke::after {
    content: '';
    position: absolute;
    background: var(--akzent);
  }

  .es__marke::before {
    top: -6px;
    left: -6px;
    width: 12px;
    height: 12px;
  }

  .es__marke::after {
    top: 0;
    bottom: 0;
    left: -1px;
    width: 2px;
  }

  .es__regler {
    position: absolute;
    inset: -10px 0 -6px;
    width: 100%;
    height: calc(100% + 16px);
    margin: 0;
    opacity: 0;
