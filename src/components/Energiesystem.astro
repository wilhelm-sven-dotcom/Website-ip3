---
// „Ein Tag im Energiesystem“: isometrische Landschaft mit Windpark, Freifläche, Speichern,
// Umspannwerk, Gewerbe und Wohnhäusern. Ein Tagesmodell treibt die Energieflüsse an; Marker,
// Begriffe im Text und die Elemente selbst öffnen eine Infokarte direkt an der Grafik.
// Ohne JavaScript: Zustand um 13:00 Uhr mit Pfeilen und alle Texte als Liste.
import { energiesystemDaten, fuellePegel } from '../lib/energiesystem-szene.js';
import { pfad } from '../lib/linienzug.js';
import { fuellstandStufe, phaseBei } from '../lib/energiesystem-modell.js';
import { titel, einleitung, bildunterschrift, phasen, legende, ui, elemente, fuellstand, lagesatz } from '../data/energiesystem.js';
import Arrow from './Arrow.astro';

const { nr = '03' } = Astro.props;
const { szene, m, pfeile, kurven } = energiesystemDaten();

// Kabel am Boden und Leiterseile liegen in der Szene (Gebäude verdecken sie), Fassadenleitungen im Overlay
const kabel = Object.entries(szene.linien)
  .filter(([, l]) => l.art !== 'wand')
  .map(([id, l]) => `<path class="es-kabel es-kabel--${l.art}" data-link="${id}" data-art="${m.art[id]}" data-aktiv="${m.richtung[id] ? 1 : 0}" d="${l.zweige.map((z) => pfad(z.punkte)).join('')}"/>`)
  .join('');
const wand = Object.entries(szene.linien)
  .filter(([, l]) => l.art === 'wand')
  .map(([id, l]) => `<path class="es-kabel es-kabel--wand" data-link="${id}" data-art="${m.art[id]}" data-aktiv="${m.richtung[id] ? 1 : 0}" d="${l.zweige.map((z) => pfad(z.punkte)).join('')}"/>`)
  .join('');
const szeneHtml = (szene.ebenen[0] || '') + kabel + fuellePegel(szene.ebenen[2] || '', szene.pegel, m.soc);

const blatt = (r) => `M0 0L${(r * 0.09).toFixed(2)} ${(r * 0.14).toFixed(2)}L${(r * 0.03).toFixed(2)} ${r}L${(-r * 0.05).toFixed(2)} ${(r * 0.17).toFixed(2)}Z`;
const rotoren = szene.rotoren
  .map(
    (r, i) =>
      `<g transform="matrix(${r.matrix.join(' ')})"><g class="es-rotor" data-rotor="${i}" transform="rotate(${[14, 52, 87][i]})">${[0, 120, 240]
        .map((w) => `<path class="es-blatt" d="${blatt(r.radius)}" transform="rotate(${w})"/>`)
        .join('')}<circle class="es-nabe" r="0.42"/></g></g>`
  )
  .join('');
const fuehrung = Object.values(szene.marker)
  .filter((mk) => mk.fuehrung)
  .map((mk) => `M${mk.punkt[0]} ${mk.punkt[1]}L${mk.anker[0]} ${mk.anker[1]}`)
  .join('');

const [vbX, vbY, vbB, vbH] = szene.viewBox.split(' ').map(Number);
const verhaeltnis = `${vbB} / ${vbH}`;

// Laufzeitdaten: nur Geometrie; Texte und Tagesmodell kommen aus den Modulen
const daten = {
  viewBox: [vbX, vbY, vbB, vbH],
  linien: Object.fromEntries(Object.entries(szene.linien).map(([id, l]) => [id, l.zweige.map((z) => ({ p: z.punkte, l: z.laenge, s: z.sichtbar }))])),
  pegel: szene.pegel.map((pg) => [pg.name, pg.a, pg.b, pg.h]),
  marker: Object.fromEntries(Object.entries(szene.marker).map(([id, mk]) => [id, mk.prozent])),
};

const speicherVon = Object.fromEntries(elemente.filter((e) => e.speicher).map((e) => [e.id, e.speicher]));
const stufe = (e) => (speicherVon[e.id] ? fuellstandStufe(m.soc[speicherVon[e.id]]) : null);
const quadrate = (s) => Array.from({ length: 5 }, (_, i) => i < Math.round(((s ?? 0) / 4) * 5));
const phase13 = phaseBei(13);

// Einleitung ohne Leerraum um die Begriffe (Satzzeichen schließen direkt an)
const einleitungHtml = einleitung
  .map((teil) => (typeof teil === 'string' ? teil : `<a class="es-begriff" href="#es-el-${teil.element}" data-element="${teil.element}">${teil.begriff}</a>`))
  .join('');
---

<section class="section es" data-theme="dark" data-header-zone="dark" aria-labelledby="es-titel" data-energiesystem data-phase={phase13} data-licht="0" data-sonne="3" data-auto="0">
  <div class="wrap">
    <div class="dim"><span class="dim__num">{nr}</span><span>System</span><span class="dim__line" data-draw></span></div>
    <h2 id="es-titel" class="h1 es__titel" data-split>Energie als System gedacht<span class="dot">.</span></h2>

    <div class="es__buehne">
      <p class="lead es__lead" data-reveal>
        <Fragment set:html={einleitungHtml} />
      </p>

      <div class="es__feld" data-reveal>
        <div class="es__feld-kopf">
          <p class="es__feld-titel tech">{titel}</p>
          <button type="button" class="es__play" data-es-play hidden>
            <span class="es__play-icon" aria-hidden="true"></span>
            <span data-es-play-text>{ui.anhalten}</span>
          </button>
        </div>
        <div class="es__feld-zeit">
          <p class="es__uhr tech"><span data-es-uhr>13:00</span> <span class="es__uhr-einheit">{ui.uhr}</span></p>
          <p class="es__phase"><span data-es-phase>{phasen[phase13].name}</span></p>
          <svg class="es__sonne" viewBox="-30 -30 60 34" aria-hidden="true">
            <path class="es__sonne-bogen" d="M-24 0A24 24 0 0 1 24 0" />
            <path class="es__sonne-horizont" d="M-29 0H29" />
            <rect class="es__sonne-punkt" data-es-sonne x="-3.5" y="-27.5" width="7" height="7" />
          </svg>
        </div>
        <p class="es__satz" data-es-satz>{phasen[phase13].satz}</p>
      </div>

      <ul class="es__legende" role="list" data-reveal>
        {
          legende.map((l) => (
            <li class={`es__legende-eintrag es__legende-eintrag--${l.art}`}>
              <span class="es__legende-zeichen" aria-hidden="true" />
              <span>
                <strong>{l.titel}</strong> {l.text}
              </span>
            </li>
          ))
        }
      </ul>

      <figure class="es__figur" aria-describedby="es-beschreibung">
        <p id="es-beschreibung" class="visually-hidden">{ui.beschreibung}</p>
        <div class="es__rahmen" data-es-rahmen>
          <div class="es__ebene" style={`aspect-ratio:${verhaeltnis}`} data-es-ebene>
            <svg class="iso es__szene" viewBox={szene.viewBox} style="--iso-stroke:1.1px" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" data-draw-svg data-es-szene set:html={szeneHtml} />
            <svg class="es__overlay" viewBox={szene.viewBox} xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" data-es-overlay>
              <Fragment set:html={wand} />
              {fuehrung && <path class="es-fuehrung" d={fuehrung} />}
              <g class="es-pfeile" data-es-pfeile>
                <path class="es-pf es-pf--gruen" d={pfeile.gruen} />
                <path class="es-pf es-pf--netz" d={pfeile.netz} />
                <path class="es-pf es-pf--gruen-wahl" d={pfeile['gruen-wahl']} />
                <path class="es-pf es-pf--netz-wahl" d={pfeile['netz-wahl']} />
              </g>
              <g class="es-teilchen" data-es-teilchen>
                <path class="es-t es-t--gruen" d="" />
                <path class="es-t es-t--netz" d="" />
                <path class="es-t es-t--gruen-wahl" d="" />
                <path class="es-t es-t--netz-wahl" d="" />
              </g>
              <g class="es-rotoren" set:html={rotoren} />
            </svg>

            <div class="es__marker" role="toolbar" aria-label={ui.elemente} aria-orientation="horizontal" data-es-marker>
              {
                elemente.map((e, i) => (
                  <button
                    type="button"
                    class="es-marker"
                    data-element={e.id}
                    style={`left:${szene.marker[e.id].prozent[0]}%;top:${szene.marker[e.id].prozent[1]}%`}
                    data-seite={szene.marker[e.id].seite}
                    tabindex={i === 0 ? '0' : '-1'}
                    aria-label={`${e.nr} ${e.name}`}
                    aria-expanded="false"
                    aria-controls="es-karte"
                    disabled
                  >
                    <span class="es-marker__nr tech" aria-hidden="true">
                      {e.nr}
                    </span>
                    <span class="es-marker__name" aria-hidden="true">
                      {e.kurz}
                    </span>
                    {e.speicher && (
                      <span class="es-marker__pegel" aria-hidden="true" data-es-pegel={e.speicher}>
                        {quadrate(stufe(e)).map((voll) => (
                          <i class={voll ? 'is-voll' : undefined} />
                        ))}
                      </span>
                    )}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="es-karte" id="es-karte" role="region" aria-labelledby="es-karte-titel" tabindex="-1" hidden data-es-karte>
            <p class="es-karte__nr tech" data-es-karte-nr></p>
            <h3 class="es-karte__titel" id="es-karte-titel" data-es-karte-titel></h3>
            <p class="es-karte__text" data-es-karte-text></p>
            <p class="es-karte__jetzt">
              <span class="es-karte__label tech">{ui.jetzt} · <span data-es-karte-uhr></span> {ui.uhr}</span>
              <span data-es-karte-lage></span>
              <span class="es-karte__fuell" data-es-karte-fuell></span>
            </p>
            <p class="es-karte__leistung">
              <span class="es-karte__label tech">{ui.leistung}</span>
              <span data-es-karte-leistung></span>
            </p>
            <a class="es-karte__link" href="#" data-es-karte-link>
              <span data-es-karte-link-text></span>
              <Arrow />
            </a>
            <div class="es-karte__steuerung">
              <button type="button" class="es-karte__taste" data-es-karte-schritt="-1" aria-label={ui.zurueck}>
                <Arrow direction="left" />
              </button>
              <button type="button" class="es-karte__taste" data-es-karte-schritt="1" aria-label={ui.vor}>
                <Arrow />
              </button>
              <button type="button" class="es-karte__taste es-karte__zu" data-es-karte-zu aria-label={ui.schliessen}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="es__zeitleiste" data-es-zeitleiste>
          <div class="es__skala">
            <svg class="es__kurven" viewBox={`0 0 ${kurven.breite} ${kurven.hoehe}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path class="es__kurve es__kurve--sonne" d={kurven.sonne} />
              <path class="es__kurve es__kurve--preis" d={kurven.preis} />
              <path class="es__achse" d={`M0 ${kurven.hoehe - 0.5}H${kurven.breite}`} />
              <path class="es__striche" d={Array.from({ length: 25 }, (_, i) => `M${(i / 24) * kurven.breite} ${kurven.hoehe}v${i % 6 === 0 ? -12 : -5}`).join('')} />
            </svg>
            <span class="es__marke" style="transform:translateX(54.17%)" data-es-marke aria-hidden="true"></span>
            <input class="es__regler" type="range" min="0" max="1425" step="15" value="780" aria-label={ui.uhrzeit} aria-valuetext={`13:00 ${ui.uhr}, ${phasen[phase13].name}`} hidden data-es-regler />
          </div>
          <ol class="es__stunden tech" aria-hidden="true">
            {[0, 6, 12, 18, 24].map((h) => <li style={`left:${(h / 24) * 100}%`}>{String(h).padStart(2, '0')}</li>)}
          </ol>
          <p class="es__kurven-legende tech" aria-hidden="true">
            <span class="es__kl es__kl--sonne">{ui.sonne}</span>
            <span class="es__kl es__kl--preis">{ui.preis}</span>
          </p>
          <div class="es__phasen" role="group" aria-label="Tageszeit" hidden data-es-phasen>
            {
              Object.entries(phasen).map(([id, p]) => (
                <button type="button" class="es__phase-taste" data-phase={id} aria-pressed={id === phase13 ? 'true' : 'false'}>
                  {p.name}
                </button>
              ))
            }
          </div>
        </div>
        <figcaption class="es__caption tech">
          <span>{bildunterschrift}</span>
          <span class="es__ohne-js">{ui.dargestellt}</span>
        </figcaption>
        <p class="visually-hidden" aria-live="polite" data-es-ansage></p>
      </figure>
    </div>

    <details class="es__liste" open data-es-liste>
      <summary class="es__liste-kopf tech">{ui.alleTexte}</summary>
      <ol class="es__liste-ol" role="list">
        {
          elemente.map((e) => (
            <li class="es__eintrag" id={`es-el-${e.id}`}>
              <p class="es__eintrag-nr tech">{e.nr}</p>
              <h3 class="es__eintrag-titel">{e.name}</h3>
              <p class="es__eintrag-text">{e.text}</p>
              <p class="es__eintrag-jetzt">
                <span class="tech">13:00 {ui.uhr}</span> {lagesatz(e.id, m.zustand[e.id])}
                {e.speicher && ` ${ui.speicher}: ${fuellstand[fuellstandStufe(m.soc[e.speicher])]}.`}
              </p>
              <p class="es__eintrag-leistung">
                <span class="tech">{ui.leistung}</span> {e.leistung}
              </p>
              <a class="es__eintrag-link" href={e.link.href}>
                {e.link.text}
                <Arrow />
              </a>
            </li>
          ))
        }
      </ol>
    </details>
  </div>
  <script type="application/json" data-es-daten is:inline set:html={JSON.stringify(daten)} />
</section>

<style>
  .es {
    overflow: hidden;
  }

  .es__titel {
    max-width: 11ch;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Bühne: Text links, Grafik rechts; schmal untereinander */
  .es__buehne {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    grid-template-areas:
      'lead figur'
      'feld figur'
      'legende figur'
      '. figur';
    grid-template-rows: auto auto auto 1fr;
    gap: 1.75rem var(--gutter);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .es__lead {
    grid-area: lead;
    color: var(--on-navy-sec);
    font-size: clamp(1.15rem, 0.98rem + 0.42vw, 1.4rem);
  }

  /* Begriffe stehen per set:html im Text, daher :global */
  .es__lead :global(.es-begriff) {
    color: var(--weiss);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: rgb(232 231 239 / 0.6);
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .es__lead :global(.es-begriff:hover),
  .es__lead :global(.es-begriff:focus-visible),
  .es__lead :global(.es-begriff.is-aktiv) {
    text-decoration-style: solid;
    text-decoration-color: var(--akzent);
    text-decoration-thickness: 2px;
  }

  /* Schriftfeld wie im Plankopf */
  .es__feld {
    grid-area: feld;
    border: 1px solid var(--on-navy-line-strong);
  }

  .es__feld-kopf {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    border-bottom: 1px solid var(--on-navy-line);
  }

  .es__feld-titel {
    align-self: center;
    padding: 0.7rem 1rem;
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .es__play {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 0;
    border-left: 1px solid var(--on-navy-line);
    background: transparent;
    color: var(--weiss);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .es__play:hover {
    background: rgb(232 231 239 / 0.06);
  }

  .es__play-icon {
    position: relative;
    width: 12px;
    height: 12px;
    flex: none;
  }

  .es__play-icon::before,
  .es__play-icon::after {
    content: '';
    position: absolute;
    top: 0;
    width: 4px;
    height: 12px;
    background: var(--akzent);
  }

  .es__play-icon::before {
    left: 0;
  }

  .es__play-icon::after {
    right: 0;
  }

  .es__play[aria-pressed='false'] .es__play-icon::before {
    width: 0;
    height: 0;
    border-left: 11px solid var(--akzent);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    background: none;
  }

  .es__play[aria-pressed='false'] .es__play-icon::after {
    display: none;
  }

  .es__feld-zeit {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: 0 1rem;
    padding: 0.9rem 1rem 0.2rem;
  }

  .es__uhr {
    font-size: clamp(2rem, 1.4rem + 1.6vw, 2.9rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .es__uhr-einheit {
    font-size: 0.4em;
    letter-spacing: 0.08em;
    color: var(--on-navy-sec);
  }

  .es__phase {
    font-weight: 700;
    font-size: 1.15rem;
    padding-bottom: 0.2rem;
  }

  .es__sonne {
    width: 64px;
    height: auto;
    overflow: visible;
  }

  .es__sonne-bogen,
  .es__sonne-horizont {
    fill: none;
    stroke: var(--on-navy-line-strong);
    stroke-width: 1;
  }

  .es__sonne-bogen {
    stroke-dasharray: 2 3;
  }

  .es__sonne-punkt {
    fill: var(--hell);
  }

  .es[data-sonne='0'] .es__sonne-punkt {
    fill: none;
    stroke: var(--hell);
    stroke-width: 1;
  }

  .es__satz {
    padding: 0.6rem 1rem 1rem;
    color: var(--on-navy-sec);
    min-height: calc(3 * 1.55em + 1.6rem);
  }

  .es__legende {
    grid-area: legende;
    display: grid;
    gap: 0.55rem;
    font-size: 0.92rem;
    color: var(--on-navy-sec);
  }

  .es__legende-eintrag {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
  }

  .es__legende-eintrag strong {
    color: var(--weiss);
    font-weight: 600;
  }

  .es__legende-zeichen {
    width: 10px;
    height: 10px;
    background: var(--hell);
  }

  .es__legende-eintrag--netz .es__legende-zeichen {
    background: transparent;
    border: 1.5px solid var(--hell);
  }

  .es__legende-eintrag--wahl .es__legende-zeichen {
    background: var(--akzent);
  }

  /* Grafik */
  .es__figur {
    grid-area: figur;
    margin: 0;
    min-width: 0;
  }

  .es__rahmen {
    position: relative;
    container-type: inline-size;
    container-name: es;
  }

  .es__ebene {
    position: relative;
    width: 100%;
  }

  .es__szene,
  .es__overlay {
    display: block;
    width: 100%;
    height: 100%;
  }

  .es__overlay {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
    transition: opacity 700ms var(--ease-out);
    /* eigene Ebene: Teilchen und Rotoren zeichnen die Szene darunter nicht neu */
    will-change: transform;
  }

  :global(.js-motion) .es__szene:not(:global(.is-drawn)) ~ .es__overlay,
  :global(.js-motion) .es__ebene:not(.is-gezeichnet) .es__marker {
    opacity: 0;
  }

  .es__marker {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 700ms var(--ease-out);
  }

  /* Szene: Zustände über Datenattribute der Sektion */
  .es__szene :global(.es-kabel) {
    fill: none;
    stroke: var(--on-navy-line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition:
      stroke 300ms var(--ease-out),
      opacity 300ms var(--ease-out);
  }

  .es :global(.es-kabel[data-aktiv='1']) {
    stroke: rgb(232 231 239 / 0.62);
  }

  .es :global(.es-kabel--luft) {
    stroke: rgb(232 231 239 / 0.5);
  }

  .es__overlay :global(.es-kabel) {
    fill: none;
    stroke: rgb(232 231 239 / 0.62);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .es__szene :global(.iso-pegel) {
    fill: rgb(232 231 239 / 0.2);
    stroke: none;
  }

  .es[data-licht='1'] .es__szene :global(.es-fenster[data-licht='1']),
  .es[data-licht='2'] .es__szene :global(.es-fenster:is([data-licht='1'], [data-licht='2'])),
  .es[data-licht='3'] .es__szene :global(.es-fenster) {
    fill: rgb(232 231 239 / 0.72);
  }

  .es[data-sonne='0'] .es__szene :global(.iso-panel) {
    fill: var(--navy);
  }

  .es[data-sonne='1'] .es__szene :global(.iso-panel) {
    fill: #1f2160;
  }

  .es__szene :global(.es-auto) {
    transition: opacity 500ms var(--ease-out);
  }

  .es[data-auto='0'] .es__szene :global(.es-auto) {
    opacity: 0;
  }

  /* Auswahl: zugehörige Gruppen und Leitungen bleiben, der Rest tritt zurück */
  .es__szene :global([data-node]) {
    transition: opacity 300ms var(--ease-out);
  }

  .es[data-wahl] .es__szene :global([data-node]:not(.is-wahl)) {
    opacity: 0.3;
  }

  .es[data-wahl] :global(.es-kabel:not(.is-wahl)) {
    opacity: 0.35;
  }

  .es :global(.es-kabel.is-wahl) {
