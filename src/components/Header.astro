---
import { hauptnav, leistungenNav, firma } from '../data/site.js';
import Arrow from './Arrow.astro';

const { theme = 'dark' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header" data-header data-header-theme={theme} data-initial-theme={theme}>
  <div class="site-header__bar wrap">
    <a class="site-header__logo" href="/" aria-label="ip³ Energietechnik GmbH, zur Startseite">
      <img class="logo logo--white" src="/brand/ip3-energietechnik-weiss.svg" alt="" width="220" height="33" />
      <img class="logo logo--color" src="/brand/ip3-energietechnik-farbig.svg" alt="" width="220" height="33" />
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul class="site-nav__list" role="list">
        {
          hauptnav.map((item) =>
            item.kinder ? (
              <li class="site-nav__item has-sub" data-sub>
                <a class:list={['site-nav__link', { 'is-active': isActive(item.href) }]} href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
                <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="sub-leistungen" data-sub-toggle>
                  <span class="visually-hidden">Untermenü {item.label}</span>
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                </button>
                <div class="site-nav__panel" id="sub-leistungen" data-sub-panel>
                  <div class="site-nav__panel-inner">
                    <ul role="list">
                      {item.kinder.map((k, i) => (
                        <li>
                          <a href={k.href} class:list={{ 'is-active': isActive(k.href) }} aria-current={path === k.href ? 'page' : undefined}>
                            <span class="tech num">{String(i + 1).padStart(2, '0')}</span>
                            <span class="t">{k.label}</span>
                            <span class="d">{k.kurz}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a class="arrow-link" href={item.href}>Alle Leistungen im Überblick <span class="line" /></a>
                  </div>
                </div>
              </li>
            ) : (
              <li class="site-nav__item">
                <a class:list={['site-nav__link', { 'is-active': isActive(item.href) }]} href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <a class="btn btn--primary site-header__cta" href="/kontakt">
      Projekt besprechen <Arrow />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="menu-toggle__label">Menü</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-theme="dark" data-menu hidden>
    <div class="mobile-menu__inner wrap">
      <nav aria-label="Mobile Navigation">
        <ul class="mobile-menu__list" role="list">
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Start</a></li>
          <li>
            <a href="/unsere-leistungen" aria-current={path === '/unsere-leistungen' ? 'page' : undefined}>Leistungen</a>
            <ul class="mobile-menu__sub" role="list">
              {
                leistungenNav.map((k) => (
                  <li>
                    <a href={k.href} aria-current={path === k.href ? 'page' : undefined}>
                      {k.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
          <li><a href="/referenzen" aria-current={path === '/referenzen' ? 'page' : undefined}>Referenzen</a></li>
          <li><a href="/karriere" aria-current={path === '/karriere' ? 'page' : undefined}>Karriere</a></li>
          <li><a href="/ueber-uns" aria-current={path === '/ueber-uns' ? 'page' : undefined}>Über uns</a></li>
          <li><a href="/kontakt" aria-current={path === '/kontakt' ? 'page' : undefined}>Kontakt</a></li>
        </ul>
      </nav>
      <div class="mobile-menu__foot">
        <a class="btn btn--primary" href="/kontakt">Projekt besprechen <Arrow /></a>
        <p class="tech mobile-menu__contact">
          <a href={firma.telefonHref}>{firma.telefon}</a>
          <a href={`mailto:${firma.email}`}>{firma.email}</a>
        </p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--header-h);
    color: var(--weiss);
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .site-header[data-header-theme='light'] {
    color: var(--navy);
  }

  .site-header.is-solid[data-header-theme='dark'] {
    background: var(--navy);
    box-shadow: 0 1px 0 var(--on-navy-line);
  }

  /* Über der 3D-Inszenierung: halbtransparent, die Szene scheint durch */
  .site-header.is-solid.is-over-story[data-header-theme='dark'] {
    background: rgb(12 26 61 / 0.5);
    box-shadow: none;
    backdrop-filter: blur(12px) saturate(1.1);
    -webkit-backdrop-filter: blur(12px) saturate(1.1);
  }

  .site-header.is-solid[data-header-theme='light'] {
    background: var(--weiss);
    box-shadow: 0 1px 0 var(--linie);
  }

  .site-header.is-solid[data-header-theme='hell'] {
    background: var(--hell);
    color: var(--navy);
    box-shadow: 0 1px 0 rgb(12 26 61 / 0.1);
  }

  .site-header__bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.75rem);
  }

  .site-header__logo {
    position: relative;
    display: block;
    width: clamp(168px, 14vw, 228px);
    flex: none;
    margin-right: auto;
  }

  .logo {
    width: 100%;
    height: auto;
    transition: opacity var(--dur) var(--ease-out);
  }

  .logo--color {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .site-header[data-header-theme='light'] .logo--white,
  .site-header[data-header-theme='hell'] .logo--white {
    opacity: 0;
  }

  .site-header[data-header-theme='light'] .logo--color,
  .site-header[data-header-theme='hell'] .logo--color {
    opacity: 1;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.6vw, 1.75rem);
  }

  .site-nav__item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.15rem;
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0.15rem;
    right: 0.15rem;
    bottom: 8px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease-out);
  }

  .site-nav__link:hover::after,
  .site-nav__link:focus-visible::after,
  .site-nav__link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-nav__link.is-active::after {
    background: var(--akzent);
    height: 2px;
  }

  .site-nav__toggle {
    display: grid;
    place-items: center;
    width: 30px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
  }

  .site-nav__toggle svg {
    width: 12px;
    height: 12px;
    transition: transform var(--dur) var(--ease-out);
  }

  .has-sub.is-open .site-nav__toggle svg {
    transform: rotate(180deg);
  }

  .site-nav__panel {
    position: absolute;
    top: calc(100% + 14px);
    left: -1.5rem;
    width: min(560px, 80vw);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      visibility 0s linear var(--dur);
  }

  .site-nav__panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -16px;
    height: 16px;
  }

  .has-sub.is-open .site-nav__panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      visibility 0s;
  }

  .site-nav__panel-inner {
    background: var(--weiss);
    color: var(--text);
    padding: 0.75rem 0.75rem 1.1rem;
    box-shadow:
      0 0 0 1px rgb(12 26 61 / 0.08),
      0 24px 60px -20px rgb(12 26 61 / 0.35);
  }

  .site-nav__panel ul a {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    column-gap: 0.5rem;
    padding: 0.85rem 0.85rem;
    text-decoration: none;
    transition: background-color var(--dur-fast);
  }

  .site-nav__panel ul a:hover,
  .site-nav__panel ul a:focus-visible,
  .site-nav__panel ul a.is-active {
    background: var(--box);
  }

  .site-nav__panel .num {
    grid-row: span 2;
    color: var(--akzent);
    font-size: 0.85rem;
    padding-top: 0.15rem;
  }

  .site-nav__panel .t {
    font-weight: 700;
    color: var(--blau);
    font-size: 1.05rem;
  }

  .site-nav__panel .d {
    font-size: 0.9rem;
    color: var(--text-sec);
  }

  .site-nav__panel .arrow-link {
    margin: 0.5rem 0.85rem 0;
    color: var(--blau);
    font-size: 0.95rem;
  }

  .site-header__cta {
    min-height: 46px;
    padding-block: 0.7rem;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-height: 48px;
    min-width: 48px;
    padding: 0 0 0 0.75rem;
    border: 0;
    background: none;
    font-family: var(--font-tech);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .menu-toggle__icon {
    position: relative;
    width: 26px;
    height: 12px;
  }

  .menu-toggle__icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition:
      transform var(--dur) var(--ease-out),
      top var(--dur) var(--ease-out);
  }

  .menu-toggle__icon span:first-child {
    top: 0;
  }

  .menu-toggle__icon span:last-child {
    top: 10px;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span:first-child {
    top: 5px;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon span:last-child {
    top: 5px;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    padding-top: calc(var(--header-h) + 1.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding-bottom: 2rem;
  }

  .mobile-menu__list > li {
    border-bottom: 1px solid var(--on-navy-line);
  }

  .mobile-menu__list > li > a {
    display: block;
    padding: 0.6rem 0;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(2rem, 9vw, 2.8rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
  }

  .mobile-menu a[aria-current='page'] {
    color: var(--akzent);
  }

  .mobile-menu__sub {
    display: grid;
    gap: 0.1rem;
    padding: 0 0 1rem;
  }

  .mobile-menu__sub a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 1.1rem;
    color: var(--on-navy-sec);
    text-decoration: none;
  }

  .mobile-menu__sub a::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    margin-right: 0.8rem;
    background: var(--akzent);
  }

  .mobile-menu__foot {
    display: grid;
    gap: 1.25rem;
  }

  .mobile-menu__foot p {
    line-height: 2;
    color: var(--on-navy-sec);
  }

  .mobile-menu__contact {
    display: grid;
  }

  .mobile-menu__foot a:not(.btn) {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  @media (max-width: 1080px) {
    .site-nav,
    .site-header__cta {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  :global(html.menu-open) .site-header {
    background: var(--navy);
    color: var(--weiss);
    box-shadow: none;
  }

  :global(html.menu-open) .site-header .logo--white {
    opacity: 1;
  }

  :global(html.menu-open) .site-header .logo--color {
    opacity: 0;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
