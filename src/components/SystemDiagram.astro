---
// Vereinfachtes Übersichtsschaltbild: PV-Generator, Wechselrichter, Transformator,
// Batteriespeicher, Übergabestation am Netzverknüpfungspunkt und Netz.
// Positionsnummern wie in einer technischen Zeichnung, Legende als HTML.
const { nr = '03' } = Astro.props;

const positions = [
  {
    n: 1,
    titel: 'PV-Generator',
    text: 'Modulauswahl, Belegung und Verschaltung. Grundlage sind Verschattungsanalyse und Ertragsprognose.',
  },
  {
    n: 2,
    titel: 'Wechselrichter',
    text: 'Ausgelegt auf Modulfeld und Netzanschluss. Die passende Kombination aus Modul und Wechselrichter entscheidet über den Ertrag.',
  },
  {
    n: 3,
    titel: 'Transformator',
    text: 'Bei größeren Anlagen der Übergang auf Mittelspannung, mit Anlagenzertifikat nach VDE-AR-N 4110, wo gefordert.',
  },
  {
    n: 4,
    titel: 'Batteriespeicher',
    text: 'Vom Speicher für Eigenverbrauch bis zum Großspeicher im zweistelligen Megawattbereich, ausgelegt auf Lastgang und Einsatzzweck.',
  },
  {
    n: 5,
    titel: 'Übergabestation · NVP',
    text: 'Netzanschlussbegehren, Abstimmung mit dem Netzbetreiber und Planung der Übergabe am Netzverknüpfungspunkt.',
  },
  {
    n: 6,
    titel: 'Netz',
    text: 'Inbetriebnahme, Registrierung im Marktstammdatenregister und auf Wunsch die Anbindung an die Direktvermarktung.',
  },
];
---

<section class="section system" data-theme="dark" data-header-zone="dark" aria-labelledby="system-title" data-system>
  <img class="zeichen zeichen--dark system__zeichen" src="/brand/zeichen-3-kontur-akzent.png" alt="" width="808" height="1052" loading="lazy" data-parallax="-14" />
  <div class="wrap">
    <div class="dim"><span class="dim__num">{nr}</span><span>System</span><span class="dim__line" data-draw></span></div>

    <div class="system__head">
      <h2 id="system-title" class="h1" data-split>Energie als System gedacht<span class="dot">.</span></h2>
      <p class="lead" data-reveal>
        Ein Modul allein ist noch kein Kraftwerk. Ertrag, Speicher und Netzanschluss beeinflussen sich gegenseitig. Deshalb planen wir sie zusammen.
      </p>
    </div>

    <figure class="sld" data-reveal="fade">
      <!-- Querformat ab Tablet -->
      <svg class="sld__svg sld__svg--wide" viewBox="0 0 1200 540" aria-hidden="true" data-draw-svg>
        <g class="sld__grid">
          <path d="M40 40 H1160 M40 500 H1160" />
        </g>

        <!-- 1 PV-Generator -->
        <g class="sld__pos" data-pos="1">
          <rect x="70" y="118" width="140" height="104" class="sld__sym" data-stroke></rect>
          <path d="M116.7 118 V222 M163.3 118 V222 M70 170 H210" class="sld__fine" data-stroke></path>
          <path d="M70 222 L210 118" class="sld__sym" data-stroke></path>
          <path d="M96 78 l18 22 M122 72 l18 22 M148 78 l18 22" class="sld__fine" data-stroke></path>
          <path d="M108 96 l6 4 l-1 -7 M134 90 l6 4 l-1 -7 M160 96 l6 4 l-1 -7" class="sld__fine" data-stroke></path>
          <text x="140" y="258" class="sld__label" text-anchor="middle">PV-Generator</text>
        </g>

        <!-- 2 Wechselrichter -->
        <g class="sld__pos" data-pos="2">
          <rect x="300" y="120" width="100" height="100" class="sld__sym" data-stroke></rect>
          <path d="M300 220 L400 120" class="sld__sym" data-stroke></path>
          <path d="M314 140 H338 M314 148 H338" class="sld__fine" data-stroke></path>
          <path d="M362 196 q6 -8 12 0 t12 0" class="sld__fine" data-stroke></path>
          <text x="350" y="258" class="sld__label" text-anchor="middle">Wechselrichter</text>
        </g>

        <!-- 3 Transformator PV -->
        <g class="sld__pos" data-pos="3">
          <circle cx="560" cy="170" r="34" class="sld__sym" data-stroke></circle>
          <circle cx="602" cy="170" r="34" class="sld__sym" data-stroke></circle>
          <text x="581" y="258" class="sld__label" text-anchor="middle">NS / MS</text>
          <circle cx="560" cy="400" r="34" class="sld__sym" data-stroke></circle>
          <circle cx="602" cy="400" r="34" class="sld__sym" data-stroke></circle>
        </g>

        <!-- 4 Batteriespeicher mit bidirektionalem Wechselrichter -->
        <g class="sld__pos" data-pos="4">
          <rect x="70" y="348" width="140" height="104" class="sld__sym" data-stroke></rect>
          <path d="M108 372 V428 M124 384 V416 M140 372 V428 M156 384 V416 M172 372 V428" class="sld__sym" data-stroke></path>
          <path d="M96 400 H108 M172 400 H184" class="sld__fine" data-stroke></path>
          <rect x="300" y="350" width="100" height="100" class="sld__sym" data-stroke></rect>
          <path d="M300 450 L400 350" class="sld__sym" data-stroke></path>
          <path d="M314 370 H338 M314 378 H338" class="sld__fine" data-stroke></path>
          <path d="M362 426 q6 -8 12 0 t12 0" class="sld__fine" data-stroke></path>
          <text x="140" y="488" class="sld__label" text-anchor="middle">Batteriespeicher</text>
          <text x="350" y="488" class="sld__label" text-anchor="middle">Speicherumrichter</text>
        </g>

        <!-- 5 Übergabestation / NVP -->
        <g class="sld__pos" data-pos="5">
          <rect x="820" y="104" width="120" height="362" class="sld__box" data-stroke></rect>
          <path d="M880 136 V434" class="sld__bus" data-stroke></path>
          <rect x="744" y="160" width="20" height="20" class="sld__sym" data-stroke></rect>
          <path d="M744 160 l20 20 M764 160 l-20 20" class="sld__fine" data-stroke></path>
          <rect x="744" y="390" width="20" height="20" class="sld__sym" data-stroke></rect>
          <path d="M744 390 l20 20 M764 390 l-20 20" class="sld__fine" data-stroke></path>
          <rect x="960" y="275" width="20" height="20" class="sld__sym" data-stroke></rect>
          <path d="M960 275 l20 20 M980 275 l-20 20" class="sld__fine" data-stroke></path>
          <text x="880" y="92" class="sld__label" text-anchor="middle">Übergabestation</text>
          <text x="896" y="290" class="sld__label sld__label--small">NVP</text>
        </g>

        <!-- 6 Netz -->
        <g class="sld__pos" data-pos="6">
          <path d="M1090 262 H1150 M1090 285 H1150 M1090 308 H1150" class="sld__sym" data-stroke></path>
          <path d="M1112 252 l-8 66 M1128 252 l8 66" class="sld__fine" data-stroke></path>
          <text x="1120" y="350" class="sld__label" text-anchor="middle">20-kV-Netz</text>
        </g>

        <!-- Leitungen -->
        <g class="sld__wires">
          <path d="M210 170 H300" data-stroke></path>
          <path d="M400 170 H526" data-stroke></path>
          <path d="M636 170 H744 M764 170 H880" data-stroke></path>
          <path d="M210 400 H300" data-stroke></path>
          <path d="M400 400 H526" data-stroke></path>
          <path d="M636 400 H744 M764 400 H880" data-stroke></path>
          <path d="M880 285 H960 M980 285 H1090" data-stroke></path>
        </g>
        <g class="sld__tags">
          <text x="255" y="160" text-anchor="middle">DC</text>
          <text x="463" y="160" text-anchor="middle">AC</text>
          <text x="255" y="390" text-anchor="middle">DC</text>
          <text x="463" y="390" text-anchor="middle">AC</text>
          <text x="1035" y="275" text-anchor="middle">MS</text>
        </g>

        <!-- Energiefluss -->
        <g class="sld__flow">
          <path d="M210 170 H300" class="f1"></path>
          <path d="M400 170 H526" class="f1"></path>
          <path d="M636 170 H880" class="f1"></path>
          <path d="M880 285 H1090" class="f1"></path>
          <path d="M210 400 H300" class="f2"></path>
          <path d="M400 400 H526" class="f2"></path>
          <path d="M636 400 H880" class="f2"></path>
        </g>

        <!-- Positionsnummern -->
        <g class="sld__balloons">
          <g data-pos="1"><path d="M210 118 L236 92" /><circle cx="248" cy="80" r="15" /><text x="248" y="85" text-anchor="middle">1</text></g>
          <g data-pos="2"><path d="M400 120 L426 94" /><circle cx="438" cy="82" r="15" /><text x="438" y="87" text-anchor="middle">2</text></g>
          <g data-pos="3"><path d="M626 146 L652 120" /><circle cx="664" cy="108" r="15" /><text x="664" y="113" text-anchor="middle">3</text></g>
          <g data-pos="4"><path d="M210 348 L236 322" /><circle cx="248" cy="310" r="15" /><text x="248" y="315" text-anchor="middle">4</text></g>
          <g data-pos="5"><path d="M940 120 L966 94" /><circle cx="978" cy="82" r="15" /><text x="978" y="87" text-anchor="middle">5</text></g>
          <g data-pos="6"><path d="M1150 262 L1170 236" /><circle cx="1176" cy="222" r="15" /><text x="1176" y="227" text-anchor="middle">6</text></g>
        </g>
      </svg>

      <!-- Hochformat für Smartphones -->
      <svg class="sld__svg sld__svg--tall" viewBox="0 0 360 760" aria-hidden="true" data-draw-svg>
        <g class="sld__pos" data-pos="1">
          <rect x="40" y="40" width="110" height="80" class="sld__sym" data-stroke></rect>
          <path d="M76.7 40 V120 M113.3 40 V120 M40 80 H150" class="sld__fine" data-stroke></path>
          <path d="M40 120 L150 40" class="sld__sym" data-stroke></path>
          <text x="166" y="86" class="sld__label">PV-Generator</text>
        </g>
        <g class="sld__pos" data-pos="2">
          <rect x="55" y="190" width="80" height="80" class="sld__sym" data-stroke></rect>
          <path d="M55 270 L135 190" class="sld__sym" data-stroke></path>
          <path d="M66 206 H86 M66 213 H86" class="sld__fine" data-stroke></path>
          <path d="M104 252 q5 -7 10 0 t10 0" class="sld__fine" data-stroke></path>
          <text x="150" y="236" class="sld__label">Wechselrichter</text>
        </g>
        <g class="sld__pos" data-pos="3">
          <circle cx="95" cy="350" r="28" class="sld__sym" data-stroke></circle>
          <circle cx="95" cy="384" r="28" class="sld__sym" data-stroke></circle>
          <text x="140" y="372" class="sld__label">NS / MS</text>
        </g>
        <g class="sld__pos" data-pos="4">
          <rect x="230" y="420" width="96" height="70" class="sld__sym" data-stroke></rect>
          <path d="M256 436 V474 M268 444 V466 M280 436 V474 M292 444 V466 M304 436 V474" class="sld__sym" data-stroke></path>
          <text x="278" y="512" class="sld__label" text-anchor="middle">Speicher</text>
        </g>
        <g class="sld__pos" data-pos="5">
          <rect x="30" y="470" width="130" height="90" class="sld__box" data-stroke></rect>
          <path d="M50 515 H140" class="sld__bus" data-stroke></path>
          <text x="95" y="545" class="sld__label sld__label--small" text-anchor="middle">NVP</text>
        </g>
        <g class="sld__pos" data-pos="6">
          <path d="M70 660 V720 M95 660 V720 M120 660 V720" class="sld__sym" data-stroke></path>
          <text x="140" y="696" class="sld__label">20-kV-Netz</text>
        </g>
        <g class="sld__wires">
          <path d="M95 120 V190" data-stroke></path>
          <path d="M95 270 V322" data-stroke></path>
          <path d="M95 412 V515" data-stroke></path>
          <path d="M278 420 V380 H200 V515 H140" data-stroke></path>
          <path d="M95 515 V660" data-stroke></path>
        </g>
        <g class="sld__flow">
          <path d="M95 120 V190" class="f1"></path>
          <path d="M95 270 V322" class="f1"></path>
          <path d="M95 412 V515" class="f1"></path>
          <path d="M95 515 V660" class="f1"></path>
          <path d="M278 420 V380 H200 V515 H140" class="f2"></path>
        </g>
        <g class="sld__balloons">
          <g data-pos="1"><circle cx="24" cy="30" r="13" /><text x="24" y="35" text-anchor="middle">1</text></g>
          <g data-pos="2"><circle cx="38" cy="182" r="13" /><text x="38" y="187" text-anchor="middle">2</text></g>
          <g data-pos="3"><circle cx="50" cy="330" r="13" /><text x="50" y="335" text-anchor="middle">3</text></g>
          <g data-pos="4"><circle cx="336" cy="412" r="13" /><text x="336" y="417" text-anchor="middle">4</text></g>
          <g data-pos="5"><circle cx="20" cy="460" r="13" /><text x="20" y="465" text-anchor="middle">5</text></g>
          <g data-pos="6"><circle cx="46" cy="650" r="13" /><text x="46" y="655" text-anchor="middle">6</text></g>
        </g>
      </svg>
      <figcaption class="sld__caption tech">Vereinfachtes Übersichtsschaltbild: PV-Anlage mit Batteriespeicher am Mittelspannungsnetz</figcaption>
    </figure>

    <ol class="legend" role="list">
      {
        positions.map((p) => (
          <li class="legend__item" data-pos={p.n} tabindex="0" data-reveal>
            <span class="legend__n tech" aria-hidden="true">
              {p.n}
            </span>
            <h3 class="legend__title">{p.titel}</h3>
            <p class="legend__text">{p.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .system {
    overflow: hidden;
  }

  .system__zeichen {
    right: -20vmin;
    top: -8vmin;
    width: clamp(380px, 76vmin, 980px);
  }

  .system__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2rem var(--gutter);
    align-items: end;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .system__head .h1 {
    max-width: 11ch;
  }

  .system__head .lead {
    color: var(--on-navy-sec);
    max-width: 34rem;
  }

  .sld {
    margin: clamp(3rem, 6vw, 5.5rem) 0 0;
  }

  .sld__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .sld__svg--tall {
    display: none;
    max-width: 420px;
    margin-inline: auto;
  }

  .sld__grid path {
    fill: none;
    stroke: var(--on-navy-line);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .sld__sym,
  .sld__fine,
  .sld__box,
  .sld__bus,
  .sld__wires path {
    fill: none;
    stroke: var(--hell);
    vector-effect: non-scaling-stroke;
    transition:
      stroke 300ms var(--ease-out),
      opacity 300ms var(--ease-out);
  }

  .sld__sym {
    stroke-width: 1.6;
  }

  .sld__fine {
    stroke-width: 1;
    opacity: 0.7;
  }

  .sld__box {
    stroke-width: 1;
    stroke-dasharray: 6 5;
    opacity: 0.55;
  }

  .sld__bus {
    stroke-width: 5;
  }

  .sld__wires path {
    stroke-width: 1.6;
    opacity: 0.75;
  }

  .sld__flow path {
    fill: none;
    stroke: var(--akzent);
    stroke-width: 3;
    stroke-dasharray: 10 38;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    animation: sld-flow 2.2s linear infinite;
  }

  .sld__flow .f2 {
    animation-name: sld-flow-bi;
    animation-duration: 7s;
  }

  @keyframes sld-flow {
    to {
      stroke-dashoffset: -48;
    }
  }

  @keyframes sld-flow-bi {
    0% {
      stroke-dashoffset: 0;
    }
    50% {
      stroke-dashoffset: -144;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  .sld__label {
    font-family: var(--font-tech);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: 0.04em;
    fill: var(--hell);
  }

  .sld__svg--tall .sld__label {
    font-size: 16px;
  }

  .sld__label--small {
    font-size: 13px;
    fill: var(--on-navy-sec);
  }

  .sld__tags text {
    font-family: var(--font-tech);
    font-size: 12px;
    letter-spacing: 0.12em;
    fill: var(--on-navy-sec);
  }

  .sld__balloons path {
    fill: none;
    stroke: var(--on-navy-line-strong);
    stroke-width: 1;
  }

  .sld__balloons circle {
    fill: var(--navy);
    stroke: var(--hell);
    stroke-width: 1;
    transition:
      fill 300ms var(--ease-out),
      stroke 300ms var(--ease-out);
  }

  .sld__balloons text {
    font-family: var(--font-tech);
    font-weight: 700;
    font-size: 14px;
    fill: var(--weiss);
  }

  /* Hervorhebung einer Position */
  .sld.has-active .sld__pos:not(.is-active) :is(.sld__sym, .sld__fine, .sld__box, .sld__bus) {
    opacity: 0.28;
  }

  .sld__pos.is-active :is(.sld__sym, .sld__bus) {
    stroke: var(--weiss);
  }

  .sld__balloons g.is-active circle {
    fill: var(--akzent);
    stroke: var(--akzent);
  }

  .sld__caption {
    margin-top: 1.5rem;
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-navy-sec);
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--gutter);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: 0;
    list-style: none;
  }

  .legend__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    column-gap: 0.75rem;
    padding: 1.4rem 0 1.6rem;
    border-top: 1px solid var(--on-navy-line);
    cursor: default;
    transition: border-color 300ms var(--ease-out);
  }

  .legend__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: 100%;
    background: var(--akzent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 520ms var(--ease-out);
  }

  .legend__item.is-active::before {
    transform: scaleX(1);
  }

  .legend__item:focus-visible {
    outline-offset: 4px;
  }

  .legend__n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--hell);
    border-radius: 50%;
    font-size: 0.85rem;
    font-weight: 700;
    transition:
      background-color 300ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  .legend__item.is-active .legend__n {
    background: var(--akzent);
    border-color: var(--akzent);
  }

  .legend__title {
    font-size: 1.2rem;
    line-height: 1.25;
    margin-top: 0.2rem;
  }

  .legend__text {
    margin-top: 0.5rem;
    font-size: 0.98rem;
    color: var(--on-navy-sec);
  }

  @media (max-width: 960px) {
    .legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .system__head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .sld__svg--wide {
      display: none;
    }

    .sld__svg--tall {
      display: block;
    }

    .legend {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sld__flow path {
      animation: none;
      stroke-dasharray: 2 10;
      opacity: 0.6;
    }
  }
</style>

<script>
  // Verknüpft Legende und Schaltbild: Hover, Fokus und Antippen heben die Position hervor
  document.querySelectorAll('[data-system]').forEach((root) => {
    const fig = root.querySelector('.sld');
    const items = [...root.querySelectorAll('.legend__item')];
    const activate = (n) => {
      fig.classList.toggle('has-active', n !== null);
      root.querySelectorAll('[data-pos]').forEach((el) => el.classList.toggle('is-active', n !== null && el.dataset.pos === String(n)));
    };
    items.forEach((it) => {
      it.addEventListener('pointerenter', () => activate(it.dataset.pos));
      it.addEventListener('pointerleave', () => activate(null));
      it.addEventListener('focus', () => activate(it.dataset.pos));
      it.addEventListener('blur', () => activate(null));
      it.addEventListener('click', () => activate(it.dataset.pos));
    });
    root.querySelectorAll('.sld__pos').forEach((g) => {
      g.addEventListener('pointerenter', () => activate(g.dataset.pos));
      g.addEventListener('pointerleave', () => activate(null));
    });
  });
</script>
