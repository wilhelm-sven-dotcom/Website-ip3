---
// Referenz als Kachel für Übersichten: Foto im Format 4:3 (ohne Foto die Zeichnung des
// Anlagentyps), Titel als Link über die ganze Kachel, darunter Kategorie und Ort. Bewusst ohne
// Einblend-, Neige- und Enthüllungseffekte, damit sich lange Listen ruhig scrollen lassen.
import Foto from './Foto.astro';
import { drawing } from '../lib/drawings.js';
import { projektHref } from '../data/referenzen.js';

const { ref, headingLevel = 3, sizes = '(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 420px', loading = 'lazy' } = Astro.props;
const H = `h${headingLevel}`;
const meta = [ref.kategorie, ref.ort].filter(Boolean).join(' · ');
---

<article class="kachel">
  <div class="kachel__bild">
    {
      ref.bild ? (
        <Foto class="kachel__foto" src={ref.bild} alt={ref.bildAlt} sizes={sizes} pos={ref.bildPos} loading={loading} />
      ) : (
        <div class="kachel__zeichnung" aria-hidden="true" set:html={drawing(ref.zeichnung, '', { animate: false })} />
      )
    }
  </div>
  <div class="kachel__text">
    <H class="kachel__titel">
      <a class="kachel__link" href={projektHref(ref)}>{ref.titel}</a>
    </H>
    <p class="kachel__meta tech">{meta}</p>
    {ref.leistung && <p class="kachel__wert tech">{ref.leistung}</p>}
  </div>
</article>

<style>
  .kachel {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--weiss);
    border: 1px solid var(--linie);
    transition: border-color 300ms var(--ease-out);
  }

  .kachel__bild {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--box);
    background-image:
      linear-gradient(rgb(47 36 130 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(47 36 130 / 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
  }

  .kachel :global(.kachel__foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .kachel__zeichnung {
    position: absolute;
    inset: 12% 14%;
    display: grid;
    place-items: center;
  }

  .kachel__zeichnung :global(.iso) {
    width: 100%;
    height: 100%;
  }

  .kachel__text {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 1.05rem 1.2rem 1.25rem;
    border-top: 1px solid var(--linie);
  }

  .kachel__titel {
    font-size: clamp(1.15rem, 1.02rem + 0.4vw, 1.4rem);
    line-height: 1.2;
    color: var(--blau);
  }

  .kachel__link {
    color: inherit;
    text-decoration: none;
  }

  /* ganze Kachel klickbar */
  .kachel__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .kachel__link:focus-visible {
    outline: none;
  }

  .kachel:has(.kachel__link:focus-visible) {
    outline: 2px solid var(--blau);
    outline-offset: 4px;
  }

  .kachel__meta,
  .kachel__wert {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-sec);
  }

  .kachel__wert {
    color: var(--text);
    font-variant-numeric: tabular-nums;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.85rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .kachel:hover {
      border-color: rgb(47 36 130 / 0.35);
    }

    .kachel:hover :global(.kachel__foto) {
      transform: scale(1.03);
    }

    .kachel:hover .kachel__link {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.18em;
    }
  }
</style>
