---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EuEmblem from '../components/EuEmblem.astro';
import { firma } from '../data/site.js';
---

<Base
  title="EFRE-Förderhinweis"
  description="Förderhinweis: Die Website der ip³ Energietechnik GmbH wurde von der Europäischen Union aus dem Europäischen Fonds für regionale Entwicklung (EFRE) und vom Freistaat Bayern kofinanziert."
  footerCta={false}
>
  <PageHero kicker="Förderhinweis" title={'EFRE-Förderhinweis<span class="dot">.</span>'} crumbs={[{ label: 'EFRE-Förderhinweis' }]} zeichen={false} />

  <section class="section legal" data-theme="light" data-header-zone="light" aria-label="Förderhinweis">
    <div class="wrap legal__grid">
      <div class="prose">
        <p class="lead">
          Diese Webseite wurde von der Europäischen Union aus dem Europäischen Fonds für regionale Entwicklung (EFRE) und vom Freistaat Bayern kofinanziert.
        </p>
        <p><a href="https://www.efre-bayern.de">www.efre-bayern.de</a></p>
        <p>Projektbeschreibung: Programmierung einer neuen Webseite und Erstellung neuer Inhalte für die {firma.nameRechtlich}.</p>
      </div>
      <EuEmblem class="efre__emblem" />
    </div>
  </section>
</Base>

<style>
  .legal__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    max-width: 52rem;
  }

  .efre__emblem {
    width: min(100%, 360px);
  }
</style>
