---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import Foto from '../components/Foto.astro';
import { team, verbund } from '../data/site.js';

const kurzname = (name) => name.split(',')[0];
const initialen = (name) => kurzname(name).split(' ').map((t) => t[0]).join('');

// Herkunft als Maßkette: drei Abschnitte ohne Jahreszahlen
const herkunft = [
  {
    mass: 'Planung',
    titel: 'Ingenieurbüro für erneuerbare Energien',
    text: 'ip³ ist als Ingenieurbüro gestartet: Planung von Anlagen für erneuerbare Energien sowie für Mittel- und Niederspannung. Dieses Fundament prägt bis heute, wie wir an Projekte herangehen.',
    fuerSie: 'eine Planung, die Erzeugung, Speicher und Netzanschluss bis in die Mittelspannung zusammen denkt.',
  },
  {
    mass: 'Ausführung',
    titel: 'Beim Bayernwerk eingetragener Installateurbetrieb',
    text: 'Aus dem Ingenieurbüro wurde ein Installateurbetrieb, der beim Bayernwerk eingetragen ist. Wir planen Ihre Anlage nicht nur, wir errichten sie auch und nehmen sie in Betrieb.',
    fuerSie: 'ein Ansprechpartner von der Planung bis zur Inbetriebnahme.',
  },
  {
    mass: 'Verbund',
    titel: 'Gemeinsame Gesellschaft mit ENMAG',
    text: 'Mit ENMAG aus Weiden haben wir die ENMAG ip³ GmbH gegründet. ENMAG entwickelt Projekte gemeinsam mit Flächeneigentümern, ip³ bringt Planung und Ausführung ein.',
    fuerSie: 'von der Fläche bis zum Netzanschluss in einem Verbund.',
    anker: '#verbund',
  },
];

const werte = [
  {
    titel: 'Ganzheitliche Beratung',
    text: 'Wir betrachten Erzeugung, Verbrauch, Speicher und Netzanschluss zusammen, bevor wir eine Lösung empfehlen.',
  },
  {
    titel: 'Klare und ehrliche Kommunikation',
    text: 'Intern wie extern sprechen wir offen und klar. So kommt Ihr Projekt am schnellsten zum Erfolg.',
  },
  {
    titel: 'Arbeit am Detail',
    text: 'Die Arbeit am Detail setzt uns vom Wettbewerb ab. Wir formen Ihre Ideen und Wünsche und setzen sie durch aktives Planen um.',
  },
];
---

<Base
  title="Über uns"
  description="ip³ Energietechnik GmbH aus Theisseil bei Weiden: als Ingenieurbüro gestartet, heute beim Bayernwerk eingetragener Installateurbetrieb für Photovoltaik und Batteriespeicher. Gemeinsame Gesellschaft mit ENMAG aus Weiden."
>
  <PageHero
    kicker="Über uns"
    title={'Energie, die aus der Region kommt<span class="dot">.</span>'}
    lead="ip³ ist ein Fachbetrieb für erneuerbare Energien aus der Oberpfalz. Als Ingenieurbüro gestartet, sind wir heute ein beim Bayernwerk eingetragener Installateurbetrieb. Mit ENMAG aus Weiden bilden wir einen Verbund für Projekte von der Fläche bis zum Netz."
    crumbs={[{ label: 'Über uns' }]}
  />

  <section class="section herkunft" data-theme="light" data-header-zone="light" aria-labelledby="herkunft-title">
    <div class="wrap">
      <div class="dim"><span class="dim__num">01</span><span>Herkunft</span><span class="dim__line" data-draw></span></div>
      <h2 id="herkunft-title" class="display herkunft__title" data-split>Aus der Planung gewachsen<span class="dot">.</span></h2>
      <ol class="kette" role="list">
        {
          herkunft.map((h, i) => (
            <li class="kette__teil" data-reveal>
              <p class="kette__mass tech">
                <span class="kette__nr">{String(i + 1).padStart(2, '0')}</span>
                {h.mass}
              </p>
              <h3 class="kette__titel">{h.titel}</h3>
              <p class="kette__text">{h.text}</p>
              <p class="kette__fuer">
                <span class="kette__fuer-label">Für Ihr Projekt:</span> {h.fuerSie}
              </p>
              {h.anker && (
                <a class="arrow-link kette__link" href={h.anker}>
                  Zum Verbund <span class="line" />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="verbund" class="section verbund" data-theme="dark" data-header-zone="dark" aria-labelledby="verbund-title">
    <div class="wrap">
      <div class="dim"><span class="dim__num">02</span><span>Verbund</span><span class="dim__line" data-draw></span></div>
      <p class="kicker verbund__claim">{verbund.claim}</p>
      <h2 id="verbund-title" class="display verbund__title" data-split>{verbund.titel}<span class="dot">.</span></h2>
      <p class="lead verbund__lead" data-reveal>
        Mit ENMAG aus Weiden haben wir eine gemeinsame Gesellschaft gegründet, die ENMAG ip³ GmbH. Beide Unternehmen bleiben eigenständig, die Aufgaben sind klar verteilt.
      </p>

      <div class="verbund__partner">
        {
          verbund.partner.map((pt, i) => (
            <article class:list={['partnerspalte', { 'partnerspalte--enmag': i === 1 }]} aria-labelledby={`partner-${i}`} data-reveal>
              <p class="partnerspalte__rolle tech">{pt.rolle}</p>
              <h3 id={`partner-${i}`} class="partnerspalte__name">
                {pt.name}
              </h3>
              <ul class="partnerspalte__aufgaben" role="list">
                {pt.aufgaben.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
              {pt.url ? (
                <a class="partnerspalte__web tech" href={pt.url} target="_blank" rel="noopener">
                  {pt.web}
                  <span class="visually-hidden"> (Website von ENMAG, neues Fenster)</span>
                </a>
              ) : (
                <p class="partnerspalte__web tech">{pt.web}</p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section werte-sec" data-theme="hell" data-header-zone="hell" aria-labelledby="werte-title">
    <div class="wrap">
      <div class="dim"><span class="dim__num">03</span><span>Arbeitsweise</span><span class="dim__line" data-draw></span></div>
      <h2 id="werte-title" class="h2 werte__title" data-split>Aktiv planen heißt Zukunft gestalten<span class="dot">.</span></h2>
      <ol class="werte" role="list">
        {
          werte.map((w, i) => (
            <li class="wert" data-reveal>
              <p class="wert__nr tech">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="wert__titel">{w.titel}</h3>
              <p class="wert__text">{w.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section team" data-theme="light" data-header-zone="light" aria-labelledby="team-title">
    <img class="zeichen zeichen--light team__zeichen" src="/brand/zeichen-3-kontur-rot.png" alt="" width="607" height="864" loading="lazy" data-parallax="12" />
    <div class="wrap">
      <div class="team__head">
        <div>
          <div class="dim"><span class="dim__num">04</span><span>Menschen</span><span class="dim__line" data-draw></span></div>
          <h2 id="team-title" class="h2 team__title" data-split>Ihre Ansprechpartner<span class="dot">.</span></h2>
        </div>
        <p class="lead team__lead" data-reveal>
          Geschäftsführung, Projektleitung, Elektrotechnik, Planung und technisches Zeichnen, Lager und Digital Services: Ihr Projekt bleibt von der ersten Skizze bis zur Inbetriebnahme in einer Hand.
        </p>
      </div>
      <ul class="kontakte" role="list">
        {
          team.map((p, i) => (
            <li class:list={['kontakt', { 'kontakt--gf': i < 2 }]} data-reveal>
              <div class="kontakt__bild">
                {p.foto ? (
                  <Foto
                    class="kontakt__foto"
                    src={p.foto}
                    alt={`Porträt ${kurzname(p.name)}`}
                    sizes={i < 2 ? '(max-width: 760px) 44vw, 340px' : '(max-width: 760px) 46vw, (max-width: 1080px) 30vw, 300px'}
                    stufen={[320, 640, 800]}
                  />
                ) : (
                  <span class="kontakt__monogramm tech" aria-hidden="true">
                    {initialen(p.name)}
                  </span>
                )}
              </div>
              <div class="kontakt__text">
                <p class="kontakt__name">{p.name}</p>
                <p class="kontakt__rolle tech">{p.rolle}</p>
                <a class="kontakt__mail" href={`mailto:${p.email}`}>{p.email}</a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section karriere" data-theme="hell" data-header-zone="hell" aria-labelledby="karriere-title">
    <div class="wrap karriere__grid">
      <h2 id="karriere-title" class="h1" data-split>Arbeiten, wo Energie zu Hause ist<span class="dot">.</span></h2>
      <div class="karriere__text">
        <p class="lead" data-reveal>Wir suchen Verstärkung als Elektriker / Elektroniker (m/w/d) in Vollzeit.</p>
        <a class="btn btn--ghost" href="/karriere" data-reveal>Zur Stellenanzeige <Arrow /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .herkunft__title {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    max-width: 12ch;
  }

  /* Maßkette: eine Linie, drei Abschnitte mit Begrenzungsstrichen wie auf einer Zeichnung */
  .kette {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .kette__teil {
    position: relative;
    padding: 0 clamp(1rem, 2.4vw, 2.25rem) 0.5rem;
  }

  .kette__teil::before,
  .kette__teil:last-child::after {
    content: '';
    position: absolute;
    top: 2.15rem;
    width: 1px;
    height: 22px;
    margin-top: -11px;
    background: var(--blau);
    transform: rotate(45deg);
  }

  .kette__teil::before {
    left: 0;
  }

  .kette__teil:last-child::after {
    right: 0;
  }

  .kette__mass {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 2.15rem;
    margin: 0 calc(-1 * clamp(1rem, 2.4vw, 2.25rem));
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--blau);
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blau);
  }

  .kette__nr {
    color: var(--akzent-text);
  }

  .kette__titel {
    margin-top: 1.6rem;
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem);
    line-height: 1.2;
    color: var(--blau);
  }

  .kette__text {
    margin-top: 0.85rem;
    color: var(--text-sec);
  }

  .kette__fuer {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--linie);
  }

  .kette__fuer-label {
    font-weight: 700;
    color: var(--blau);
  }

  .kette__link {
    margin-top: 0.6rem;
    color: var(--blau);
  }

  /* Verbund mit ENMAG: Navy, zwei gleichwertige Spalten, ENMAG-Grün nur für ENMAG */
  .verbund {
    --enmag: #4c9b3b;
  }

  .verbund__claim {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .verbund__title {
    margin-top: 1rem;
    max-width: 13ch;
  }

  .verbund__lead {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 44rem;
    color: var(--on-navy-sec);
  }

  .verbund__partner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid var(--on-navy-line-strong);
    border-bottom: 1px solid var(--on-navy-line-strong);
  }

  .partnerspalte {
    padding: clamp(1.75rem, 3.5vw, 3rem) clamp(1.25rem, 3.5vw, 3.5rem) clamp(1.75rem, 3.5vw, 3rem) 0;
  }

  .partnerspalte + .partnerspalte {
    padding-left: clamp(1.25rem, 3.5vw, 3.5rem);
    padding-right: 0;
    border-left: 1px solid var(--on-navy-line-strong);
  }

  .partnerspalte__rolle {
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-navy-sec);
  }

  .partnerspalte__name {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--weiss);
  }

  /* ENMAG-Name in ENMAG-Grün, ab 24 px: 4,9:1 auf Navy */
  .partnerspalte--enmag .partnerspalte__name {
    color: var(--enmag);
  }

  .partnerspalte__aufgaben {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .partnerspalte__aufgaben li {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    color: var(--weiss);
  }

  .partnerspalte__aufgaben li::before {
    content: '';
    width: 6px;
    height: 6px;
    margin-top: 0.6em;
    background: var(--on-navy-line-strong);
  }

  .partnerspalte--enmag .partnerspalte__aufgaben li::before {
    background: var(--enmag);
  }

  .partnerspalte__web {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--on-navy-sec);
  }

  a.partnerspalte__web {
    min-height: 44px;
    padding-top: 0.7rem;
    margin-top: 1.05rem;
    color: var(--weiss);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--enmag);
  }

  a.partnerspalte__web:hover {
    text-decoration-thickness: 2px;
  }

  .werte__title {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    max-width: 16ch;
  }

  .werte {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem var(--gutter);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .wert {
    border-top: 2px solid var(--blau);
    padding-top: 1.4rem;
  }

  .wert__nr {
    color: var(--akzent-text);
    font-size: 0.9rem;
  }

  .wert__titel {
    margin-top: 0.6rem;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    color: var(--blau);
  }

  .wert__text {
    margin-top: 0.8rem;
    color: var(--text-sec);
  }

  .team {
    overflow: hidden;
  }

  .team__zeichen {
    right: -10vmin;
    top: 10%;
    width: clamp(260px, 44vmin, 560px);
  }

  .team__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem var(--gutter);
    align-items: end;
  }

  .team__title {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    max-width: 14ch;
  }

  .team__lead {
    max-width: 38rem;
    color: var(--text-sec);
  }

  /* Geschäftsführung groß mit Text daneben, das Team darunter in fünf Spalten */
  .kontakte {
    position: relative;
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 0 var(--gutter);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--linie);
  }

  .kontakt {
    grid-column: span 2;
    padding: 1.5rem 0 1.4rem;
    border-bottom: 1px solid var(--linie);
  }

  .kontakt--gf {
    grid-column: span 5;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: end;
  }

  .kontakt__bild {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--box);
  }

  .kontakt__bild :global(.kontakt__foto) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kontakt__monogramm {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--hell);
    color: var(--blau);
    font-size: clamp(2rem, 1.4rem + 2vw, 3.2rem);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .kontakt__text {
    padding-top: 1rem;
  }

  .kontakt--gf .kontakt__text {
    padding: 0 0 0.25rem;
  }

  .kontakt--gf .kontakt__name {
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.8rem);
  }

  .kontakt__name {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--blau);
  }

  .kontakt__rolle {
    overflow-wrap: anywhere;
    margin-top: 0.3rem;
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-sec);
  }

  .kontakt__mail {
    display: inline-block;
    margin-top: 0.55rem;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: var(--linie);
    overflow-wrap: anywhere;
  }

  .kontakt__mail:hover {
    text-decoration-color: var(--akzent);
  }

  .karriere__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem var(--gutter);
    align-items: end;
  }

  .karriere__grid .h1 {
    max-width: 12ch;
  }

  .karriere__text {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .karriere__text .lead {
    color: var(--text-sec);
  }

  @media (max-width: 960px) {
    .team__head,
    .karriere__grid {
      grid-template-columns: 1fr;
    }

    .werte {
      grid-template-columns: 1fr;
    }

    /* Maßkette senkrecht: Linie links, Abschnitte untereinander */
    .kette {
      grid-template-columns: 1fr;
      border-left: 1px solid var(--blau);
    }

    .kette__teil {
      padding: 0 0 2.25rem 1.6rem;
    }

    .kette__teil::before {
      top: 0.55rem;
      left: -1px;
      transform: rotate(-45deg);
    }

    .kette__teil:last-child::after {
      display: none;
    }

    .kette__mass {
      justify-content: flex-start;
      height: auto;
      margin: 0;
      padding-bottom: 0;
      border-bottom: 0;
    }

    .kette__titel {
      margin-top: 0.75rem;
    }

    .verbund__partner {
      grid-template-columns: 1fr;
    }

    .partnerspalte,
    .partnerspalte + .partnerspalte {
      padding: 1.75rem 0;
      border-left: 0;
    }

    .partnerspalte + .partnerspalte {
      border-top: 1px solid var(--on-navy-line-strong);
    }
  }

  @media (max-width: 1080px) {
    .kontakte {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .kontakt--gf {
      grid-column: span 3;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .kontakt--gf .kontakt__text {
      padding-top: 1rem;
    }
  }

  @media (max-width: 760px) {
    .kontakte {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .kontakt {
      grid-column: span 1;
    }

    .kontakt--gf {
      grid-column: span 2;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      gap: 1rem;
    }

    .kontakt--gf .kontakt__text {
      padding: 0;
    }

    .kontakt__rolle {
      letter-spacing: 0.08em;
    }

    .kontakt__mail {
      font-size: 0.85rem;
    }
  }
</style>
