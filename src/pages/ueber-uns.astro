---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import Foto from '../components/Foto.astro';
import { team } from '../data/site.js';

const kurzname = (name) => name.split(',')[0];
const initialen = (name) => kurzname(name).split(' ').map((t) => t[0]).join('');

const werte = [
  {
    titel: 'Ganzheitliche Beratung',
    text: 'Wir betrachten Erzeugung, Verbrauch, Speicher und Netzanschluss zusammen, bevor wir eine Lösung empfehlen.',
  },
  {
    titel: 'Klare und ehrliche Kommunikation',
    text: 'Intern wie extern sprechen wir offen und klar. So kommt Ihr Projekt am schnellsten zum Erfolg.',
  },
  {
    titel: 'Arbeit am Detail',
    text: 'Die Arbeit am Detail setzt uns vom Wettbewerb ab. Wir formen Ihre Ideen und Wünsche und setzen sie durch aktives Planen um.',
  },
];
---

<Base
  title="Über uns"
  description="ip³ Energietechnik GmbH aus Theisseil bei Weiden: 2009 als Ingenieurbüro gestartet, heute Fachunternehmen für schlüsselfertige Photovoltaikanlagen und Batteriespeicher."
>
  <PageHero
    kicker="Über uns"
    title={'Energie, die aus der Region kommt<span class="dot">.</span>'}
    lead="ip³ ist ein Fachbetrieb für erneuerbare Energien aus der Oberpfalz. 2009 als Ingenieurbüro gestartet, haben wir uns zu Energieeffizienzexperten und zum Dienstleistungspartner für schlüsselfertige Energielösungen weiterentwickelt. Wir sind eingetragener Partner beim Bayernwerk."
    crumbs={[{ label: 'Über uns' }]}
  />

  <section class="section story-about" data-theme="light" data-header-zone="light" aria-labelledby="weg-title">
    <div class="wrap">
      <div class="dim"><span class="dim__num">01</span><span>Unser Weg</span><span class="dim__line" data-draw></span></div>
      <div class="weg">
        <h2 id="weg-title" class="display weg__title" data-split>Vom Ingenieurbüro zum Fachbetrieb<span class="dot">.</span></h2>
        <ol class="weg__line" role="list">
          <li data-reveal>
            <p class="weg__year tech">2009</p>
            <h3>Start als Ingenieurbüro</h3>
            <p>Gestartet als Ingenieurbüro in der Oberpfalz.</p>
          </li>
          <li data-reveal>
            <p class="weg__year tech">Heute</p>
            <h3>Planung, Beratung und Umsetzung</h3>
            <p>Der gesamte Projektzyklus von der Grundlagenermittlung über Planung und Bauüberwachung bis zur Inbetriebnahme und Schulung des Personals. Schlüsselfertig für Privat, Gewerbe, Industrie und Freiflächen, bis zum Großspeicher im zweistelligen Megawattbereich.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section werte-sec" data-theme="hell" data-header-zone="hell" aria-labelledby="werte-title">
    <div class="wrap">
      <div class="dim"><span class="dim__num">02</span><span>Arbeitsweise</span><span class="dim__line" data-draw></span></div>
      <h2 id="werte-title" class="h2 werte__title" data-split>Aktiv planen heißt Zukunft gestalten<span class="dot">.</span></h2>
      <ol class="werte" role="list">
        {
          werte.map((w, i) => (
            <li class="wert" data-reveal>
              <p class="wert__nr tech">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="wert__titel">{w.titel}</h3>
              <p class="wert__text">{w.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section team" data-theme="light" data-header-zone="light" aria-labelledby="team-title">
    <img class="zeichen zeichen--light team__zeichen" src="/brand/zeichen-3-kontur-rot.png" alt="" width="607" height="864" loading="lazy" data-parallax="12" />
    <div class="wrap">
      <div class="team__head">
        <div>
          <div class="dim"><span class="dim__num">03</span><span>Menschen</span><span class="dim__line" data-draw></span></div>
          <h2 id="team-title" class="h2 team__title" data-split>Ihre Ansprechpartner<span class="dot">.</span></h2>
        </div>
        <p class="lead team__lead" data-reveal>
          Geschäftsführung, Projektleitung, Elektrotechnik, Planung und technisches Zeichnen, Lager und Digital Services: Ihr Projekt bleibt von der ersten Skizze bis zur Inbetriebnahme in einer Hand.
        </p>
      </div>
      <ul class="kontakte" role="list">
        {
          team.map((p, i) => (
            <li class:list={['kontakt', { 'kontakt--gf': i < 2 }]} data-reveal>
              <div class="kontakt__bild">
                {p.foto ? (
                  <Foto
                    class="kontakt__foto"
                    src={p.foto}
                    alt={`Porträt ${kurzname(p.name)}`}
                    sizes={i < 2 ? '(max-width: 760px) 44vw, 340px' : '(max-width: 760px) 46vw, (max-width: 1080px) 30vw, 300px'}
                    stufen={[320, 640, 800]}
                  />
                ) : (
                  <span class="kontakt__monogramm tech" aria-hidden="true">
                    {initialen(p.name)}
                  </span>
                )}
              </div>
              <div class="kontakt__text">
                <p class="kontakt__name">{p.name}</p>
                <p class="kontakt__rolle tech">{p.rolle}</p>
                <a class="kontakt__mail" href={`mailto:${p.email}`}>{p.email}</a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section karriere" data-theme="hell" data-header-zone="hell" aria-labelledby="karriere-title">
    <div class="wrap karriere__grid">
      <h2 id="karriere-title" class="h1" data-split>Arbeiten, wo Energie zu Hause ist<span class="dot">.</span></h2>
      <div class="karriere__text">
        <p class="lead" data-reveal>Wir suchen Verstärkung als Elektriker / Elektroniker (m/w/d) in Vollzeit.</p>
        <a class="btn btn--ghost" href="/karriere" data-reveal>Zur Stellenanzeige <Arrow /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .weg {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 3rem var(--gutter);
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    align-items: end;
  }

  .weg__title {
    max-width: 11ch;
  }

  .weg__line {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-left: 2rem;
    border-left: 1px solid var(--linie);
  }

  .weg__line li {
    position: relative;
  }

  .weg__line li::before {
    content: '';
    position: absolute;
    left: calc(-2rem - 6px);
    top: 0.45rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--weiss);
    border: 1px solid var(--blau);
  }

  .weg__line li:last-child::before {
    background: var(--akzent);
    border-color: var(--akzent);
  }

  .weg__year {
    font-size: 2rem;
    font-weight: 700;
    color: var(--blau);
    line-height: 1;
  }

  .weg__line h3 {
    margin-top: 0.6rem;
    font-size: 1.3rem;
    color: var(--blau);
  }

  .weg__line p:not(.weg__year) {
    margin-top: 0.5rem;
    color: var(--text-sec);
  }

  .werte__title {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    max-width: 16ch;
  }

  .werte {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem var(--gutter);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .wert {
    border-top: 2px solid var(--blau);
    padding-top: 1.4rem;
  }

  .wert__nr {
    color: var(--akzent-text);
    font-size: 0.9rem;
  }

  .wert__titel {
    margin-top: 0.6rem;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    color: var(--blau);
  }

  .wert__text {
    margin-top: 0.8rem;
    color: var(--text-sec);
  }

  .team {
    overflow: hidden;
  }

  .team__zeichen {
    right: -10vmin;
    top: 10%;
    width: clamp(260px, 44vmin, 560px);
  }

  .team__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem var(--gutter);
    align-items: end;
  }

  .team__title {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    max-width: 14ch;
  }

  .team__lead {
    max-width: 38rem;
    color: var(--text-sec);
  }

  /* Geschäftsführung groß mit Text daneben, das Team darunter in fünf Spalten */
  .kontakte {
    position: relative;
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 0 var(--gutter);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--linie);
  }

  .kontakt {
    grid-column: span 2;
    padding: 1.5rem 0 1.4rem;
    border-bottom: 1px solid var(--linie);
  }

  .kontakt--gf {
    grid-column: span 5;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: end;
  }

  .kontakt__bild {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--box);
  }

  .kontakt__bild :global(.kontakt__foto) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kontakt__monogramm {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--hell);
    color: var(--blau);
    font-size: clamp(2rem, 1.4rem + 2vw, 3.2rem);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .kontakt__text {
    padding-top: 1rem;
  }

  .kontakt--gf .kontakt__text {
    padding: 0 0 0.25rem;
  }

  .kontakt--gf .kontakt__name {
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.8rem);
  }

  .kontakt__name {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--blau);
  }

  .kontakt__rolle {
    overflow-wrap: anywhere;
    margin-top: 0.3rem;
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-sec);
  }

  .kontakt__mail {
    display: inline-block;
    margin-top: 0.55rem;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: var(--linie);
    overflow-wrap: anywhere;
  }

  .kontakt__mail:hover {
    text-decoration-color: var(--akzent);
  }

  .karriere__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem var(--gutter);
    align-items: end;
  }

  .karriere__grid .h1 {
    max-width: 12ch;
  }

  .karriere__text {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .karriere__text .lead {
    color: var(--text-sec);
  }

  @media (max-width: 960px) {
    .weg,
    .team__head,
    .karriere__grid {
      grid-template-columns: 1fr;
    }

    .werte {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 1080px) {
    .kontakte {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .kontakt--gf {
      grid-column: span 3;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .kontakt--gf .kontakt__text {
      padding-top: 1rem;
    }
  }

  @media (max-width: 760px) {
    .kontakte {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .kontakt {
      grid-column: span 1;
    }

    .kontakt--gf {
      grid-column: span 2;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      gap: 1rem;
    }

    .kontakt--gf .kontakt__text {
      padding: 0;
    }

    .kontakt__rolle {
      letter-spacing: 0.08em;
    }

    .kontakt__mail {
      font-size: 0.85rem;
    }
  }
</style>
