---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ReferenceTile from '../components/ReferenceTile.astro';
import Galerie from '../components/Galerie.astro';
import { veroeffentlicht, filterGruppen, gruppenVon } from '../data/referenzen.js';

// Zunächst erscheinen so viele Projekte, der Rest auf Wunsch; ohne JavaScript alle
const ZUERST = 9;
---

<Base
  title="Referenzen"
  description="Referenzen der ip³ Energietechnik GmbH: Photovoltaik auf Landwirtschaft und Gewerbe, Freiflächenanlagen, Carports sowie Heim- und Industriespeicher in der Oberpfalz und darüber hinaus."
>
  <PageHero
    kicker="Referenzen"
    title={'Gebaut und am Netz<span class="dot">.</span>'}
    lead="Zufriedene Kunden sind der beste Nachweis für Erfahrung und Kompetenz. Hier ein Einblick in Anlagen, die wir bereits umgesetzt haben. Das ist nur ein Auszug: Weitere Projekte und Details zu besonderen Anforderungen zeigen wir Ihnen gern auf Anfrage."
    crumbs={[{ label: 'Referenzen' }]}
  />

  <section class="section refs-page" data-theme="light" data-header-zone="light" aria-labelledby="refs-list-title" data-refs data-zuerst={ZUERST}>
    <div class="wrap">
      <h2 id="refs-list-title" class="visually-hidden">Projektübersicht</h2>
      <div class="filter" role="group" aria-label="Referenzen filtern" data-filterleiste hidden>
        {
          filterGruppen.map((f, i) => (
            <button type="button" class="filter__btn" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label}
            </button>
          ))
        }
        <p class="filter__count tech" aria-live="polite"><span data-count>{veroeffentlicht.length}</span> Projekte</p>
      </div>

      <ul class="refs-page__grid" id="refs-liste" role="list" data-refs-liste>
        {
          veroeffentlicht.map((r, i) => (
            <li class="refs-page__item" data-tags={gruppenVon(r).join(' ')}>
              <ReferenceTile ref={r} loading={i < 3 ? 'eager' : 'lazy'} />
            </li>
          ))
        }
      </ul>
      <div class="refs-page__mehr" data-mehr-zeile hidden>
        <button type="button" class="btn btn--ghost" data-mehr aria-controls="refs-liste">
          <span data-mehr-text>Weitere Projekte anzeigen</span>
        </button>
      </div>
      <p class="refs-page__note muted">Ohne Foto: schematische Darstellung des Anlagentyps. Kennwerte, soweit veröffentlicht.</p>
    </div>
  </section>

  <Galerie name="projekte" theme="hell" />
</Base>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--linie);
  }

  .filter[hidden] {
    display: none;
  }

  .filter__btn {
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgb(47 36 130 / 0.3);
    background: var(--weiss);
    color: var(--blau);
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }

  .filter__btn:hover {
    border-color: var(--blau);
  }

  .filter__btn[aria-pressed='true'] {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--weiss);
  }

  .filter__count {
    margin-left: auto;
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-sec);
  }

  .refs-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 2.6vw, 2.5rem) var(--gutter);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .refs-page__item[hidden] {
    display: none;
  }

  /* Mit JavaScript stehen zunächst neun Projekte; das Skript übernimmt danach über hidden.
     So springt die Liste beim Laden nicht von 18 auf 9. */
  :global(html.js) .refs-page__grid:not([data-bereit]) > .refs-page__item:nth-child(n + 10) {
    display: none;
  }

  .refs-page__mehr {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .refs-page__mehr[hidden] {
    display: none;
  }

  .refs-page__note {
    margin-top: 2.5rem;
    font-size: 0.85rem;
  }

  @media (max-width: 1080px) {
    .refs-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .refs-page__grid {
      grid-template-columns: 1fr;
    }

    .filter__count {
      width: 100%;
      margin-left: 0;
    }
  }
</style>

<script>
  // Filter und schrittweises Anzeigen. Zustand je Sitzung gespeichert, damit die Liste nach
  // dem Zurückkehren von einer Projektseite so aussieht wie vorher.
  const SCHLUESSEL = 'ip3-referenzen';
  const lesen = () => {
    try {
      return JSON.parse(sessionStorage.getItem(SCHLUESSEL) || '{}');
    } catch {
      return {};
    }
  };
  const merken = (z) => {
    try {
      sessionStorage.setItem(SCHLUESSEL, JSON.stringify(z));
    } catch {
      /* ohne Speicher gilt die Standardansicht */
    }
  };

  document.querySelectorAll('[data-refs]').forEach((root) => {
    const zuerst = Number(root.dataset.zuerst) || 9;
    const liste = root.querySelector('[data-refs-liste]');
    const buttons = [...root.querySelectorAll('[data-filter]')];
    const items = [...root.querySelectorAll('[data-tags]')];
    const count = root.querySelector('[data-count]');
    const mehrZeile = root.querySelector('[data-mehr-zeile]');
    const mehr = root.querySelector('[data-mehr]');
    const mehrText = root.querySelector('[data-mehr-text]');
    const gespeichert = lesen();
    let filter = buttons.some((b) => b.dataset.filter === gespeichert.filter) ? gespeichert.filter : 'alle';
    let alle = gespeichert.alle === true;

    const treffer = () => items.filter((it) => filter === 'alle' || it.dataset.tags.split(' ').includes(filter));

    const zeigen = ({ fokus = false } = {}) => {
      const t = treffer();
      const vorher = new Set(items.filter((it) => !it.hidden));
      items.forEach((it) => (it.hidden = true));
      t.forEach((it, i) => (it.hidden = !alle && i >= zuerst));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      if (count) count.textContent = String(t.length);
      const rest = t.length - Math.min(t.length, alle ? t.length : zuerst);
      mehrZeile.hidden = rest <= 0;
      mehrText.textContent = rest === 1 ? 'Ein weiteres Projekt anzeigen' : `${rest} weitere Projekte anzeigen`;
      if (fokus) {
        const neu = t.find((it) => !it.hidden && !vorher.has(it));
        neu?.querySelector('a')?.focus();
      }
      merken({ filter, alle });
      document.dispatchEvent(new Event('layout:change'));
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.filter;
        alle = false;
        zeigen();
      })
    );
    mehr.addEventListener('click', () => {
      alle = true;
      zeigen({ fokus: true });
    });

    root.querySelector('[data-filterleiste]').hidden = false;
    zeigen();
    liste.dataset.bereit = '';
  });
</script>
