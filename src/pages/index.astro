---
import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import About from '../components/About.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import ReferencesFeature from '../components/ReferencesFeature.astro';
import Process from '../components/Process.astro';
import { firma } from '../data/site.js';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: firma.name,
  url: firma.url,
  email: firma.email,
  telephone: firma.telefonIntl,
  faxNumber: '+49 961 40191369',
  slogan: 'Energie hoch drei',
  description: 'Planung, Bau und Installation von Photovoltaikanlagen und Batteriespeichern: vom Hausdach über Gewerbe und Freifläche bis zum Großspeicher.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: firma.strasse,
    postalCode: firma.plz,
    addressLocality: 'Weiden in der Oberpfalz',
    addressCountry: 'DE',
  },
  areaServed: 'Oberpfalz',
  foundingDate: '2009',
};
---

<Base headerTheme="dark">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <Story />
  <About />
  <ServiceIndex nr="02" />
  <SystemDiagram nr="03" />
  <ReferencesFeature nr="04" />
  <Process nr="05" />
</Base>
